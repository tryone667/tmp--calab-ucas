+// ============================================================================
+// divider : multi-cycle restoring divider for LA32R div.w / mod.w /
+//           div.wu / mod.wu.  start is a one-cycle pulse; the unit then runs
+//           32 steps with busy high; result is mod ? remainder : quotient,
+//           quotient truncated toward zero and remainder taking the
+//           dividend sign for the signed variants.
+// ============================================================================
+module divider(
+    input  wire        clk,
+    input  wire        reset,
+    input  wire        start,
+    input  wire        unsign,
+    input  wire        mod,
+    input  wire [31:0] a,
+    input  wire [31:0] b,
+    output wire        busy,
+    output wire [31:0] result
+);
+
+reg         busy_r;
+reg         unsign_r;
+reg         mod_r;
+reg         q_neg;
+reg         r_neg;
+reg  [63:0] acc;
+reg  [31:0] babs;
+reg  [ 4:0] step;
+reg  [31:0] quot;
+reg  [31:0] rem;
+
+assign busy   = busy_r;
+assign result = mod_r ? rem : quot;
+
+wire [31:0] rem_n = {acc[62:32], acc[31]};
+wire [31:0] q_n   = {acc[30: 0], 1'b0};
+wire        ge    = (babs != 32'd0) && (rem_n >= babs);
+wire [63:0] acc_n = ge ? {rem_n - babs, q_n | 32'd1} : {rem_n, q_n};
+
+always @(posedge clk) begin
+    if (reset) begin
+        busy_r   <= 1'b0;
+        unsign_r <= 1'b0;
+        mod_r    <= 1'b0;
+        q_neg    <= 1'b0;
+        r_neg    <= 1'b0;
+        acc      <= 64'b0;
+        babs     <= 32'b0;
+        step     <= 5'd0;
+        quot     <= 32'b0;
+        rem      <= 32'b0;
+    end
+    else if (start) begin
+        busy_r   <= 1'b1;
+        unsign_r <= unsign;
+        mod_r    <= mod;
+        q_neg    <= ~unsign && (a[31] ^ b[31]);
+        r_neg    <= ~unsign &&  a[31];
+        step     <= 5'd0;
+        if (unsign) begin
+            acc  <= {32'd0, a};
+            babs <= b;
+        end
+        else begin
+            acc  <= {32'd0, a[31] ? (~a + 32'd1) : a};
+            babs <= b[31] ? (~b + 32'd1) : b;
+        end
+    end
+    else if (busy_r) begin
+        if (step == 5'd31) begin
+            busy_r <= 1'b0;
+            if (unsign_r) begin
+                quot <= acc_n[31: 0];
+                rem  <= acc_n[63:32];
+            end
+            else begin
+                quot <= q_neg ? (~acc_n[31: 0] + 32'd1) : acc_n[31: 0];
+                rem  <= r_neg ? (~acc_n[63:32] + 32'd1) : acc_n[63:32];
+            end
+        end
+        else begin
+            step <= step + 1'b1;
+            acc  <= acc_n;
+        end
+    end
+end
+
+endmodule
