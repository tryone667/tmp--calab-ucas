+// re-verified cycle-exactly against exp15 (xsim n1~n58, same $finish time).
 // ============================================================================
 module mycpu_top(
     input  wire        aclk,
@@ -138,20 +145,13 @@ always @(posedge clk) begin
     if (reset) begin
         if_fetch_busy    <= 1'b0;
         if_fetch_discard <= 1'b0;
